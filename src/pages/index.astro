---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { home, posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const featured = home.showFeatured
  ? posts.filter(post => post.data.featured).slice(0, home.featuredLimit)
  : [];
const recent = posts.filter(
  post => !featured.some(item => item.id === post.id)
);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="masthead" aria-labelledby="masthead-title">
      {home.eyebrow && <p class="eyebrow">{home.eyebrow}</p>}
      <h1 id="masthead-title">{home.heading}</h1>
      <p class="intro">{home.introduction}</p>
    </section>
    {
      posts.length === 0 && (
        <section class="empty-state">
          <h2>{home.emptyTitle}</h2>
          <p>{home.emptyDescription}</p>
        </section>
      )
    }
    {
      featured.length > 0 && (
        <section class="writing-section" aria-labelledby="featured-title">
          <h2 id="featured-title" class="section-label">
            {home.featuredTitle}
          </h2>
          <ul>
            {featured.map(post => (
              <Card
                variant="h3"
                featured
                showCover={home.showFeaturedCover}
                {...post}
              />
            ))}
          </ul>
        </section>
      )
    }
    {
      home.showRecent && recent.length > 0 && (
        <section class="writing-section" aria-labelledby="recent-title">
          <h2 id="recent-title" class="section-label">
            {home.recentTitle}
          </h2>
          <ul>
            {recent.slice(0, postsConfig.perIndex).map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
    <p class="my-10">
      <a
        class="text-accent underline"
        href={getRelativeLocaleUrl(locale, "posts")}
        >All writing <span aria-hidden="true">&rarr;</span></a
      >
    </p>
  </main>
  <Footer />
</Layout>
