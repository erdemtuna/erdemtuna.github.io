---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import PostCover from "@/components/PostCover.astro";
import Tag from "@/components/Tag.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));
  const adjacent = (post: CollectionEntry<"posts"> | undefined) =>
    post
      ? { id: post.id, title: post.data.title, filePath: post.filePath }
      : null;
  return posts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      prevPost: adjacent(posts[index + 1]),
      nextPost: adjacent(posts[index - 1]),
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;
type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};
const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;
const { Content } = await render(post);
const postUrl = getPostUrl(post.id, post.filePath, locale).replace(/\/+$/, "");
const socialImage = typeof ogImage === "string" ? ogImage : ogImage?.src;
const image =
  socialImage ??
  (config.features.dynamicOgImage ? `${postUrl}/index.png` : undefined);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  postTitle={title}
  {author}
  {description}
  ogImage={image}
  {canonicalURL}
  {pubDatetime}
  {modDatetime}
>
  <Header />
  <BackButton />
  <main id="main-content" class="app-layout post-layout" data-pagefind-body>
    <h1
      class="post-title"
      style={{ viewTransitionName: toTransitionName(post.id) }}
      data-pagefind-meta="title"
    >
      {title}
    </h1>
    <div class="post-meta">
      <span>{author}</span>
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      <EditPost {hideEditPost} {post} />
    </div>
    <PostCover data={post.data} eager />
    <article id="article" class="app-prose mt-8 w-full">
      <Content />
    </article>
    <hr class="my-8" />
    <div data-pagefind-ignore>
      <BackToTopButton />
      <ul class="my-8 flex flex-wrap gap-4">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
      </ul>
      <ShareLinks />
      <AdjacentPostNav {prevPost} {nextPost} />
    </div>
  </main>
  <Footer />
</PostLayout>

<script>
  const initialized = new WeakSet<HTMLElement>();
  function setupArticle() {
    const article = document.querySelector<HTMLElement>("#article");
    if (!article || initialized.has(article)) return;
    initialized.add(article);
    for (const heading of article.querySelectorAll(
      "h2[id], h3[id], h4[id], h5[id], h6[id]"
    )) {
      const link = document.createElement("a");
      link.className = "heading-link ms-2 text-sm no-underline";
      link.href = `#${heading.id}`;
      link.setAttribute("aria-label", `Link to ${heading.textContent}`);
      link.innerHTML = '<span aria-hidden="true">#</span>';
      heading.append(link);
    }
    for (const table of article.querySelectorAll("table")) {
      const region = document.createElement("div");
      region.className = "table-scroll";
      region.tabIndex = 0;
      region.setAttribute("role", "region");
      region.setAttribute(
        "aria-label",
        table.caption?.textContent ?? "Scrollable table"
      );
      table.before(region);
      region.append(table);
    }
    for (const block of article.querySelectorAll("pre")) {
      block.tabIndex = 0;
      const wrapper = document.createElement("div");
      wrapper.className = "code-wrapper";
      block.before(wrapper);
      wrapper.append(block);
      const button = document.createElement("button");
      button.className = "copy-code";
      button.textContent = "Copy code";
      button.setAttribute("aria-live", "polite");
      wrapper.append(button);
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            block.querySelector("code")?.textContent ?? ""
          );
          button.textContent = "Copied";
        } catch {
          button.textContent = "Copy failed: select code to copy";
        }
        window.setTimeout(() => {
          button.textContent = "Copy code";
        }, 2000);
      });
    }
  }
  setupArticle();
  document.addEventListener("astro:page-load", setupArticle);
</script>
