---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import PostCover from "./PostCover.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
  showCover?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  id,
  data,
  filePath,
  featured = false,
  showCover = false,
} = Astro.props;

const { title, description, ...props } = data;
---

<li class:list={["post-card", { "featured-card": featured }]}>
  {
    showCover && (
      <PostCover
        {data}
        eager={featured}
        widthRem={config.design.layout.siteWidthRem - 4}
      />
    )
  }
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "inline-block",
      "underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <Datetime {...props} class="datetime" />
  <p>{description}</p>
</li>
