---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const active = (path: string) => Astro.url.pathname.startsWith(`/${path}`);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute -top-full left-5 z-50 px-3 py-2 focus:top-4"
  >{t.a11y.skipToContent}</a
>
<header class="app-layout">
  <div class="site-header">
    <a class="brand" href={getRelativeLocaleUrl(locale, "")}>{site.title}</a>
    <nav aria-label="Primary" id="nav-menu">
      <button
        id="menu-btn"
        aria-label="Open menu"
        aria-controls="menu-items"
        aria-expanded="false"
      >
        <IconMenuDeep width={24} height={24} />
      </button>
      <ul id="menu-items">
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            aria-current={active("posts") ? "page" : undefined}>Writing</a
          >
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            aria-current={active("about") ? "page" : undefined}>About</a
          >
        </li>
        {
          features.search !== false && (
            <li>
              <a
                class="utility-button"
                href={getRelativeLocaleUrl(locale, "search")}
                aria-label="Search"
                aria-current={active("search") ? "page" : undefined}
              >
                <IconSearch width={22} height={22} />
              </a>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li>
              <button
                id="theme-btn"
                class="utility-button"
                aria-label="Switch color theme"
                title="Switch color theme"
              >
                <IconMoon class="dark:hidden" width={22} height={22} />
                <IconSunHigh class="hidden dark:block" width={22} height={22} />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  #nav-menu {
    margin-left: auto;
  }
  #menu-items {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  #menu-items a {
    display: flex;
    padding: 0.5rem;
  }
  #menu-items a:hover,
  #menu-items [aria-current] {
    color: var(--accent);
  }
  #menu-items [aria-current] {
    text-decoration: underline;
  }
  .utility-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }
  #menu-btn {
    display: none;
  }
  @media (max-width: 639px) {
    :global(html[data-js]) #nav-menu #menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-left: auto;
    }
    :global(html[data-js]) #nav-menu #menu-items {
      display: none;
    }
    :global(html[data-js]) #nav-menu[data-open] #menu-items {
      display: flex;
    }
    #nav-menu[data-open] {
      width: 100%;
    }
    #menu-items {
      justify-content: flex-end;
      padding-top: 0.5rem;
    }
  }
</style>

<script>
  const bound = new WeakSet<HTMLElement>();
  function setupHeader() {
    const nav = document.querySelector<HTMLElement>("#nav-menu");
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (nav && button && !bound.has(nav)) {
      bound.add(nav);
      nav.dataset.enhanced = "";
      const setOpen = (open: boolean) => {
        nav.toggleAttribute("data-open", open);
        button.setAttribute("aria-expanded", String(open));
        button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      };
      button.addEventListener("click", () =>
        setOpen(!nav.hasAttribute("data-open"))
      );
      nav.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          setOpen(false);
          button.focus();
        }
      });
    }
    const skip = document.querySelector<HTMLElement>("#skip-to-content");
    if (skip && !bound.has(skip)) {
      bound.add(skip);
      skip.addEventListener("click", () => {
        const main = document.querySelector<HTMLElement>("#main-content");
        main?.setAttribute("tabindex", "-1");
        main?.focus();
      });
    }
  }
  setupHeader();
  document.addEventListener("astro:after-swap", setupHeader);
</script>
