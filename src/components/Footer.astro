---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import config from "@/config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";

type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border mt-12 flex flex-wrap items-center justify-between gap-4 border-t py-6"
  >
    <p>&copy; {new Date().getFullYear()} {config.site.title}</p>
    <nav
      class="flex flex-wrap items-center gap-5"
      aria-label="Supporting links"
    >
      <a href={getAssetPath("rss.xml")}>RSS</a>
      <a href={getRelativeLocaleUrl(locale, "tags")}>Tags</a>
      {
        config.features.showArchives && (
          <a href={getRelativeLocaleUrl(locale, "archives")}>Archives</a>
        )
      }
      <Socials />
    </nav>
  </div>
</footer>
